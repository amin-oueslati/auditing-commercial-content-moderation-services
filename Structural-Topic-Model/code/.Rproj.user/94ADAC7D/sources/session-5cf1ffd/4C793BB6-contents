# stan program --------------------------------------------------------------------------
voter_turnout_model_complex <- "// Stan program for Voter Turnout Model with Demographic Factors
data {
    int<lower=1> N;  // Number of observations
    int<lower=1> J;  // Number of voters
    int<lower=1> I;  // Number of elections
    array[N] int<lower=1, upper=J> jj;  // Voter index for each observation
    array[N] int<lower=1, upper=I> ii;  // Election index for each observation
    array[N] int<lower=0, upper=1> y;   // Voter turnout
    matrix[N, D] X;  // Demographic matrix
    int<lower=1> D;  // Number of demographic predictors
}

parameters {
    vector[I] alpha;  // Difficulty parameter for each election
    vector<lower=0>[I] beta;  // Discrimination parameter for each election
    vector[J] eta;  // Latent propensity for each voter influenced by demographics
    real mu_alpha;  // Mean of difficulty parameters
    real<lower=0> sigma_alpha;  // SD of difficulty parameters
    real<lower=0> sigma_beta;  // SD of discrimination parameters
    vector[D] gamma;  // Coefficients for direct demographic effects on the logistic function
    vector[D] delta;  // Coefficients for demographic effects on voter propensity
}

model {
    // Priors
    alpha ~ normal(mu_alpha, sigma_alpha);
    beta ~ lognormal(0, sigma_beta);
    eta ~ normal(X * delta, 1);  // Voter propensity influenced by demographics
    gamma ~ normal(0, 1);
    delta ~ normal(0, 1);  // Assuming a normal prior for effects of demographics on voter propensity
    mu_alpha ~ student_t(3, 0, 1);
    sigma_alpha ~ student_t(3, 0, 1);
    sigma_beta ~ student_t(3, 0, 1);

    // Likelihood incorporating demographic factors
    for (n in 1:N) {
        real pi = inv_logit(beta[ii[n]] * (eta[jj[n]] - alpha[ii[n]]) + dot_product(X[n], gamma));
        y[n] ~ bernoulli(pi);
    }

}
"

