# stan program --------------------------------------------------------------------------
voter_turnout_model <- "// Stan program for Voter Turnout Model
data {
    int<lower=1> N;                 // Number of observations
    int<lower=1> J;                 // Number of voters
    int<lower=1> I;                 // Number of elections
    array[N] int<lower=1, upper=J> jj;  // Voter index for each observation
    array[N] int<lower=1, upper=I> ii;  // Election index for each observation
    array[N] int<lower=0, upper=1> y;   // Voter turnout: 1 if voted, 0 if not
}

parameters {
    vector[I] alpha;                // Difficulty parameter for each election
    vector<lower=0>[I] beta;        // Discrimination parameter for each election
    vector[J] eta;                  // Latent propensity for each voter
    real mu_alpha;                  // Mean of difficulty parameters
    real<lower=0> sigma_alpha;      // Standard deviation of difficulty parameters
    real<lower=0> sigma_beta;       // Standard deviation of discrimination parameters
}

model {
    // Priors
    alpha ~ normal(mu_alpha, sigma_alpha);
    beta ~ lognormal(0, sigma_beta);
    eta ~ normal(0, 1);
    mu_alpha ~ student_t(3, 0, 1);        // Student-t prior for mean of alpha
    sigma_alpha ~ student_t(3, 0, 1);     // Half-Student-t prior for SD of alpha
    sigma_beta ~ student_t(3, 0, 1);      // Half-Student-t prior for SD of beta

    // Likelihood
    for (n in 1:N) {
        real pi = inv_logit(beta[ii[n]] * (eta[jj[n]] - alpha[ii[n]])); // Logit function
        y[n] ~ bernoulli(pi); // Binomial likelihood for voter turnout
    }
}
"

